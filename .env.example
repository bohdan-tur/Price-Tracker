ENVIRONMENT=development
DEBUG=false
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# Generate two different random JWT secrets containing at least 32 bytes each.
ACCESS_TOKEN_SECRET_KEY=
REFRESH_TOKEN_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=20
REFRESH_TOKEN_EXPIRES_DAYS=14

# Scraper security
SCRAPER_ALLOWED_DOMAINS='["rozetka.com.ua","foxtrot.com.ua","moyo.ua","comfy.ua","maudau.com.ua","yakaboo.ua","novus.zakaz.ua","auchan.zakaz.ua","metro.zakaz.ua","varus.ua"]'
SCRAPER_MAX_RESPONSE_BYTES=2097152
SCRAPER_MAX_URL_LENGTH=2048

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLLING_ENABLED=false

# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=price_tracker
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@db:5432/price_tracker

# Development/test seed. Keep disabled unless demo users are required.
SEED_DEFAULT_USERS=false
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Test Database
TEST_POSTGRES_USER=test_user
TEST_POSTGRES_PASSWORD=test_password_secret
TEST_POSTGRES_DB=test_price_tracker
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_password_secret@test_db:5432/test_price_tracker
